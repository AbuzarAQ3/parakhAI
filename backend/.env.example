# parakhai backend environmental variables

# django
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# allauth
SOCIALACCOUNT_ENABLED=False
# default, set to True if you want to enable social account login
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# i swapped them and spend 2 hours debugging, dont do that haha XD

# database selection
# Default to PostgreSQL if DATABASE_URL or POSTGRES_DB is provided, otherwise fallback to SQLite for local dev
POSTGRES_DB=True

# postgres
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_db_name
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_HOST=your_host
DB_PORT=5432