# parakhai GLOBAL .gitignore

# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs.io
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.trash

# ==========================================
# Django & Python
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.toml
.cache
.pytest_cache/
.noscript
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.run/

# Translations
*.mo
*.pot

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal
media/
staticfiles/
static_root/

# Scrapy
.scrapy

# Sphinx documentation
docs/_build/

# PyEnv
.python-version

# pipenv
#   According to pypa/pipenv#1056, stdlib's pipenv uses Pipfile.lock, which
#   should be tracked under version control unless building a library.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock should generally be tracked.
#poetry.lock

# uWSGI
uwsgi_params

# Jupyter Notebook
.ipynb_checkpoints

# IPython
.ipython/

# ==========================================
# Python Virtual Environments
# ==========================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
include/
lib/
share/

# ==========================================
# Node / React Frontend
# ==========================================
# Dependencies
node_modules/
/jspm_packages

# Production build outputs
/build
/dist
/out
/target

# Frontend logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.next
.nuxt
.vuepress/dist
.serverless
.fusebox
.dynamodb

# TypeScript cache
*.tsbuildinfo

# Vite/Next.js/CRA cache
.vite/
.parcel-cache

# ==========================================
# Databases (PostgreSQL / SQLite)
# ==========================================
# SQLite (Redundant fallback)
*.sqlite
*.sqlite3

# PostgreSQL / General DB dumps
*.sql
*.sql.gz
*.dump

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
venv
venv/
.venv
.venv_ubuntu
.env
.env.prod
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
.secret
.secrets
secrets.json

# ==========================================
# IDEs, Editors & Tools
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

